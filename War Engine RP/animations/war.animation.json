{
  "format_version": "1.8.0",
  "animations": {
    "animation.war.downed": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            -90,
            0,
            0
          ],
          "position": [
            0,
            2,
            0
          ]
        }
      }
    },
    "animation.war.on_mg": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            -80,
            -8,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            -80,
            12,
            0
          ]
        }
      }
    },
    "animation.war.cav_walk": {
      "loop": true,
      "bones": {
        "leg_fl": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_br": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_fr": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_bl": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.war.cav_idle": {
      "loop": true,
      "bones": {
        "neck": {
          "rotation": [
            "math.sin(query.life_time * 90) * 3 + math.cos(query.modified_distance_moved * 38.17) * 8 * query.modified_move_speed",
            0,
            0
          ]
        },
        "tail": {
          "rotation": [
            0,
            "math.sin(query.life_time * 120) * 12",
            0
          ]
        },
        "body": {
          "position": [
            0,
            "math.abs(math.cos(query.modified_distance_moved * 38.17)) * 1.2 * query.modified_move_speed",
            0
          ]
        }
      }
    },
    "animation.war.hound_walk": {
      "loop": true,
      "bones": {
        "leg0": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg3": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg1": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg2": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.war.hound_look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.war.prop_spin": {
      "loop": true,
      "bones": {
        "prop": {
          "rotation": [
            0,
            0,
            "query.life_time * 1440"
          ]
        },
        "prop2": {
          "rotation": [
            0,
            0,
            "query.life_time * 1440"
          ]
        }
      }
    },
    "animation.war.kneel": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            -5,
            0
          ]
        },
        "rightLeg": {
          "rotation": [
            -80,
            8,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            -8,
            -6,
            0
          ]
        }
      }
    },
    "animation.war.prone": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            90,
            0,
            0
          ],
          "position": [
            0,
            2,
            0
          ]
        },
        "head": {
          "rotation": [
            -80,
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            -90,
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            -90,
            0,
            0
          ]
        }
      }
    },
    "animation.war.rotor_spin": {
      "loop": true,
      "bones": {
        "rotor": {
          "rotation": [
            0,
            "query.has_rider ? query.life_time * 1080 : 0",
            0
          ]
        },
        "tail_rotor": {
          "rotation": [
            "query.has_rider ? query.life_time * 1800 : 0",
            0,
            0
          ]
        }
      }
    }
  }
}