{
  "format_version": "1.8.0",
  "animations": {
    "animation.war.downed": {
      "loop": "hold_on_last_frame",
      "bones": {
        "root": {
          "rotation": [
            "-90 * math.min(1, math.pow(math.min(q.anim_time, 1) / 0.45, 2)) + (q.anim_time > 0.45 ? 9 * math.abs(math.sin((q.anim_time - 0.45) * 900)) * math.max(0, 1 - (q.anim_time - 0.45) * 3.5) : 0)",
            0,
            0
          ],
          "position": [
            0,
            "2 * math.min(1, math.min(q.anim_time, 1) / 0.45)",
            0
          ]
        }
      },
      "animation_length": 1.0
    },
    "animation.war.on_mg": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            -80,
            -8,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            -80,
            12,
            0
          ]
        }
      }
    },
    "animation.war.cav_walk": {
      "loop": true,
      "bones": {
        "leg_fl": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_br": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_fr": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_bl": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 50 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.war.cav_idle": {
      "loop": true,
      "bones": {
        "neck": {
          "rotation": [
            "math.sin(query.life_time * 90) * 3 + math.cos(query.modified_distance_moved * 38.17) * 8 * query.modified_move_speed",
            0,
            0
          ]
        },
        "tail": {
          "rotation": [
            0,
            "math.sin(query.life_time * 120) * 12",
            0
          ]
        },
        "body": {
          "position": [
            0,
            "math.abs(math.cos(query.modified_distance_moved * 38.17)) * 1.2 * query.modified_move_speed",
            0
          ]
        }
      }
    },
    "animation.war.hound_walk": {
      "loop": true,
      "bones": {
        "leg0": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg3": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg1": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg2": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 60 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.war.hound_look": {
      "loop": true,
      "bones": {
        "head": {
