        "prop2": {
          "rotation": [
            0,
            0,
            "query.life_time * 1440"
          ]
        }
      }
    },
    "animation.war.kneel": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            -5,
            0
          ]
        },
        "rightLeg": {
          "rotation": [
            -80,
            8,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            -8,
            -6,
            0
          ]
        }
      }
    },
    "animation.war.prone": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            90,
