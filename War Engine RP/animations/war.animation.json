        },
        "leftArm": {
          "rotation": [
            -90,
            0,
            0
          ]
        }
      }
    },
    "animation.war.rotor_spin": {
      "loop": true,
      "bones": {
        "rotor": {
          "rotation": [
            0,
            "query.has_rider ? query.life_time * 1080 : 0",
            0
          ]
        },
        "tail_rotor": {
          "rotation": [
            "query.has_rider ? query.life_time * 1800 : 0",
            0,
            0
          ]
        }
      }
    },
    "animation.war.sit": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            -11,
            0
          ]
        },
        "rightLeg": {
          "rotation": [
            -80,
            12,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            -80,
            -12,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            -25,
            0,
            0
          ]
        }
      }
    },
    "animation.war.crawl": {
      "loop": true,
      "animation_length": 1.2,
      "bones": {
        "rightArm": {
          "rotation": [
            "-150 + math.sin(q.anim_time * 300) * 35",
            "0",
            "10"
          ]
        },
        "leftArm": {
          "rotation": [
            "-150 - math.sin(q.anim_time * 300) * 35",
            "0",
            "-10"
          ]
        },
        "rightLeg": {
          "rotation": [
            "math.sin(q.anim_time * 300) * 18",
            "0",
            "0"
          ]
        },
        "leftLeg": {
          "rotation": [
            "-math.sin(q.anim_time * 300) * 18",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.war.corpse": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "-90 + (q.property('war:gib') ? 0 : (q.is_on_ground ? 0 : math.sin(q.life_time * 900) * 20))",
            "q.property('war:gib') ? v.spin * 0.6 : 0",
            "q.property('war:gib') && !q.is_on_ground ? q.life_time * 900 : 0"
          ],
          "position": [
            0,
            "q.property('war:gib') && q.property('war:limb') == 1 ? 4 : 2",
            0
          ]
        }
      }
    },
    "animation.war.ragdoll": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "v.fall",
            0,
            0
          ],
          "position": [
            0,
            "v.ly * 2",
            0
          ]
        },
        "head": {
          "rotation": [
            "v.hd",
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            "v.ra",
            0,
            "(10 + math.mod(v.p, 4) * 16) * v.ly"
          ]
        },
        "leftArm": {
          "rotation": [
            "v.la",
            0,
            "-(10 + math.mod(math.floor(v.p / 4), 4) * 16) * v.ly"
          ]
        },
        "rightLeg": {
          "rotation": [
            "v.rl",
            0,
            "(3 + math.mod(v.p, 3) * 7) * v.ly"
          ]
        },
        "leftLeg": {
          "rotation": [
            "v.ll",
            0,
            "-(3 + math.mod(v.p, 5) * 5) * v.ly"
          ]
        }
      }
    }
  }
}