{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "war:smoke_cloud",
      "basic_render_parameters": { "material": "particles_blend", "texture": "textures/particle/particles" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 4 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_sphere": { "radius": 0.8, "surface_only": false, "direction": "outwards" },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_motion_dynamic": { "linear_acceleration": [0, 0.08, 0], "linear_drag_coefficient": 1.2 },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "2.6 + variable.particle_random_1 * 1.4" },
      "minecraft:particle_appearance_billboard": {
        "size": ["1.1 + variable.particle_age * 0.45", "1.1 + variable.particle_age * 0.45"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 128, "texture_height": 128, "uv": [56, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [0.86, 0.86, 0.84, "math.clamp(1.4 - variable.particle_age / variable.particle_lifetime * 1.2, 0, 0.92)"]
      }
    }
  }
}
