{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "war:bspray",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/war_blood_atlas"
      }
    },
    "events": {
      "splatter_event": {
        "particle_effect": {
          "effect": "war:bsplat",
          "type": "particle"
        }
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.03 + (variable.crit * 0.03)",
        "direction": "outwards"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.random(1, 6) + (variable.crit * 50.0)"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 10.0
      },
      "minecraft:particle_expire_if_in_blocks": [
        "minecraft:water",
        "minecraft:kelp",
        "minecraft:seagrass"
      ],
      "minecraft:particle_lifetime_events": {
        "expiration_event": "splatter_event"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 3.0) + (variable.crit * 3.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0.0,
          -9.8,
          0.0
        ],
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "collision_radius": 0.075,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 96,
          "texture_height": 128,
          "uv": [
            "math.floor(variable.particle_random_1 * 3.0) * 32.0",
            "0.0"
          ],
          "uv_size": [
            32,
            32
          ]
        }
      }
    }
  }
}